PORT=3000

POSTGRES_USER=codebridge
POSTGRES_PASSWORD=replace_with_your_password
POSTGRES_DB=codebridge_ai

DATABASE_URL=postgresql://codebridge:your_chosen_password@localhost:5433/codebridge_ai
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_ORIGIN=http://localhost:5173
# Keep lax for localhost and same-site HTTPS origins.
# For separate HTTPS sites, set NODE_ENV=production and SESSION_COOKIE_SAME_SITE=none on the API.
SESSION_COOKIE_SAME_SITE=lax

AI_SERVICE_URL=http://127.0.0.1:8080
AI_MODEL=Qwen/Qwen2.5-3B-Instruct-GGUF:Q4_K_M
AI_TIMEOUT_MS=30000

# Optional Vite override. Put it in frontend/.env.local for local builds.
# VITE_API_BASE_URL=http://localhost:3000/api/v1
